DATABASE_URL=mysql://shenicest:password!@localhost:3306/shenicest_dev
SHENICEST_JWT_SECRET=<from-platform-operator-same-as-platform-JWT_SECRET>
SHENICEST_API_BASE=https://shenicest.com/platform/api
OPERATOR_USER_ID=2
FOUNDER_USER_ID=1

# Optional. Set to the parent domain (e.g. .shenicest.com) so the
# shenicest_token cookie carries a Domain attribute and is shared with the
# main site (shenicest.com/platform) for SSO. Leave unset on localhost.
#COOKIE_DOMAIN=.shenicest.com
# Optional. Target of GET /auth/sso-redirect (header "主站" tab).
# Defaults to https://shenicest.com/platform.
#MAIN_SITE_URL=https://shenicest.com/platform

# Shared users table owned by the external auth system (database.table).
# Read-only source of the public founder profile (nickname, avatar_url).
SHARED_USERS_TABLE=event_management.users

# Tencent COS image upload (presigned direct upload). Bucket is public-read,
# private-write: images are read via COS_PUBLIC_BASE_URL and written only via
# pre-signed URLs generated server-side with the credentials below.
COS_SECRET_ID=<tencent-cos-secret-id>
COS_SECRET_KEY=<tencent-cos-secret-key>
COS_BUCKET=shenicest-projects-1422809617
COS_REGION=ap-shanghai
COS_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
COS_PUBLIC_BASE_URL=https://assets.shenicest.com
COS_UPLOAD_PREFIX=projects/
