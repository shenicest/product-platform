{
  "name": "shenicest-product-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@shenicest/api' dev",
    "dev:web": "bun run --filter '@shenicest/web' dev",
    "build": "bun run --filter '@shenicest/api' build && bun run --filter '@shenicest/web' build",
    "start": "bun run --filter '@shenicest/api' start",
    "test": "bun run --filter '@shenicest/api' test",
    "seed": "bun run --filter '@shenicest/api' seed"
  }
}
