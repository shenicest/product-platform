API_URL=http://localhost:3000
# Optional: shown to owners of suspended talent profiles.
NEXT_PUBLIC_TALENT_OPERATIONS_EMAIL=operations@example.com

# 主办方后台调试开关（仅本地/非生产构建生效，生产恒为关闭）：
# · 未设置 = 非生产环境默认开放，所有登录账号都能进入主办方后台并看到菜单入口；
# · 设为 false = 即使本地也按生产权限收口，用来验证生产口径。
# 生产构建（NODE_ENV=production）会忽略这个变量。
# NEXT_PUBLIC_ORGANIZER_OPEN_ACCESS=false
